{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.PostgreSQL"],
    "MinimumLevel": "Information",
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "PostgreSQL", "Args": { "connectionString": "Server=localhost;Port=5432;User Id=mvpuser;Password=mvppass;Database=mvpdb;" } }
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;User Id=mvpuser;Password=mvppass;Database=mvpdb;"
  },
  "OpenTelemetry": {
    "ServiceName": "mvp-api"
  },
  "Jwt": {
    "Key": "dev-secret-key-change-in-production-min-32-chars!",
    "Issuer": "mvp-server",
    "Audience": "mvp-frontend"
  }
}
